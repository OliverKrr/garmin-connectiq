<settings>
    <setting propertyKey="@Properties.uploadUrl" title="@Strings.SetUploadUrl">
        <settingConfig type="alphaNumeric" />
    </setting>
    <setting propertyKey="@Properties.uploadToken" title="@Strings.SetUploadToken">
        <settingConfig type="alphaNumeric" />
    </setting>
    <setting propertyKey="@Properties.useLte" title="@Strings.SetUseLte">
        <settingConfig type="boolean" />
    </setting>
    <setting propertyKey="@Properties.partKb" title="@Strings.SetPartKb">
        <settingConfig type="numeric" min="1" max="32" />
    </setting>
    <setting propertyKey="@Properties.maxMin" title="@Strings.SetMaxMin">
        <settingConfig type="numeric" min="1" max="30" />
    </setting>
    <setting propertyKey="@Properties.keepDays" title="@Strings.SetKeepDays">
        <settingConfig type="numeric" min="0" max="365" />
    </setting>
    <setting propertyKey="@Properties.keepKb" title="@Strings.SetKeepKb">
        <settingConfig type="numeric" min="64" max="8192" />
    </setting>
    <setting propertyKey="@Properties.retryMin" title="@Strings.SetRetryMin">
        <settingConfig type="numeric" min="5" max="60" />
    </setting>
</settings>
